# Copy to .env and edit. All values are optional.

# offline | ollama | groq | openai   (can also be changed in the Settings page)
LLM_PROVIDER=offline

# Local Ollama (run `ollama list` to see installed models)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Hosted providers. Keys stay on the server and are never sent to the browser.
GROQ_API_KEY=your-GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# auto = sentence-transformers if installed, otherwise the built-in hashing embedder
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hard server limits. The UI can lower these but never raise them.
MAX_RETRIEVAL_ATTEMPTS=3
MAX_REGENERATIONS=1
RETRIEVAL_TOP_K=8
CONTEXT_CHUNKS=5
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
# Upload and dataset limits. The defaults below are built in, so leave these commented
# unless you need different values. (Uncommented lines here override the defaults.)
# MAX_UPLOAD_MB=8192
# MAX_ARCHIVE_MB=16384
# MAX_ARCHIVE_UNCOMPRESSED_MB=65536
# MAX_ARCHIVE_ENTRIES=10000
# MAX_TABLE_ROWS=20000000
# Rows of each table turned into searchable passages (an even sample above this;
# the column profile still covers every row). 0 = embed every row (slow for big data).
# MAX_EMBED_ROWS=25000

# Where the SQLite DB, Chroma index and uploads live (default: backend/storage)
# STORAGE_DIR=./storage
